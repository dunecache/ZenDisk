{
  "applicationId": "io.zendisk.app",
  "version": "0.0.0",
  "defaultMode": "window",
  "documentRoot": "/build/",
  "url": "/",
  "enableServer": true,
  "enableNativeAPI": true,
  "nativeAllowList": [
    "app.getConfig",
    "app.exit",
    "filesystem.readDirectory",
    "filesystem.getStats",
    "filesystem.getPath",
    "filesystem.getPathParts",
    "filesystem.readFile",
    "filesystem.copy",
    "filesystem.move",
    "filesystem.remove",
    "filesystem.createDirectory",
    "filesystem.writeFile",
    "os.execCommand",
    "os.getEnv",
    "os.showOpenDialog",
    "storage.getData",
    "storage.setData",
    "events.broadcast",
    "window.setTitle"
  ],
  "modes": {
    "window": {
      "title": "ZenDisk",
      "width": 1440,
      "height": 900,
      "minWidth": 900,
      "minHeight": 600,
      "center": true,
      "icon": "/src/renderer/assets/icon.png",
      "injectGlobals": true
    }
  },
  "cli": {
    "binaryName": "zendisk",
    "resourcesPath": "/build/",
    "distributionPath": "/release/",
    "extensionsPath": "/extensions/",
    "frontendLibrary": {
      "devUrl": "http://localhost:5173",
      "projectPath": "/",
      "initCommand": "pnpm install",
      "devCommand": "pnpm dev:web",
      "buildCommand": "pnpm build:web",
      "waitTimeout": 120000
    }
  }
}
